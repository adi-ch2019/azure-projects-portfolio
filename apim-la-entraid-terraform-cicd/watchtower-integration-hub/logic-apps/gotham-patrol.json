{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {},
    "triggers": {
      "When_a_HTTP_request_is_received": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "schema": {
            "type": "object",
            "properties": {
              "incidentType": {
                "type": "string",
                "enum": ["BANK_ROBBERY", "ALIEN_INVASION", "METEOR_STRIKE"]
              },
              "location": { "type": "string" },
              "severity": { "type": "integer", "minimum": 1, "maximum": 5 }
            }
          }
        }
      }
    },
    "actions": {
      "Route_Incident": {
        "type": "Switch",
        "expression": "@triggerBody()?.incidentType",
        "cases": {
          "BANK_ROBBERY": {
            "actions": {
              "Call_GCPD": {
                "type": "Http",
                "inputs": {
                  "method": "POST",
                  "uri": "https://gotham-police-api.herokuapp.com/incidents",
                  "body": {
                    "type": "Bank Robbery",
                    "location": "@triggerBody()?.location",
                    "priority": "@triggerBody()?.severity"
                  }
                }
              }
            }
          },
          "ALIEN_INVASION": {
            "actions": {
              "Activate_Krypton_Alert": {
                "type": "ApiConnection",
                "inputs": {
                  "host": {
                    "connectionName": "krypton-tech"
                  },
                  "method": "post",
                  "path": "/alerts",
                  "body": {
                    "message": "Alien invasion detected at @{triggerBody()?.location}",
                    "severity": "@{triggerBody()?.severity}"
                  }
                }
              }
            }
          }
        }
      },
      "Log_Incident": {
        "type": "ApiConnection",
        "inputs": {
          "host": {
            "connectionName": "azuremonitor"
          },
          "method": "post",
          "path": "/logs",
          "body": {
            "message": "Incident logged at @{utcNow()}",
            "data": "@triggerBody()"
          }
        }
      }
    }
  }
}